              "max_short_contact_count": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "min_nonlocal_distance_a": {
                "type": ["number", "null"],
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": true
          },
          "handoff_guard": {
            "type": "object",
            "properties": {
              "description": {
                "type": ["string", "null"]
              },
              "enabled": {
                "type": "boolean"
              },
              "evaluator": {
                "type": ["string", "null"]
