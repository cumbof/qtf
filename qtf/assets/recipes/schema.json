              "phases": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "fallback": {
                "type": "string"
              },
              "abort_on_reject": {
                "type": "boolean"
              },
              "allow_improving_unsafe": {
                "type": "boolean"
              },
              "max_clash_count": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "max_short_contact_count": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "min_nonlocal_distance_a": {
                "type": ["number", "null"],
                "exclusiveMinimum": 0
              },
              "unsafe_transition_max_short_contact_count": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "unsafe_transition_min_nonlocal_distance_a": {
                "type": ["number", "null"],
                "exclusiveMinimum": 0
              },
              "unsafe_transition_require_clash_count_decrease": {
                "type": "boolean"
              },
              "reject_on_score_worse": {
                "type": "boolean"
              },
              "reject_on_clash_count_increase": {
                "type": "boolean"
              },
              "reject_on_short_contact_count_increase": {
                "type": "boolean"
              },
              "reject_on_min_nonlocal_distance_decrease": {
                "type": "boolean"
              },
              "reject_on_nonfinite": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
