            "type": "object",
            "properties": {
              "description": {
                "type": ["string", "null"]
              },
              "enabled": {
                "type": "boolean"
              },
              "candidates": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "evaluators": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
